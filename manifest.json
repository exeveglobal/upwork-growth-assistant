{
  "manifest_version": 3,
  "name": "Upwork Growth Assistant",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Score Upwork jobs by Connects ROI before you apply, and keep a history of your proposals and their results.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.upwork.com/*",
    "https://ege.exeve.global/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Upwork Growth Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.upwork.com/*"],
      "js": ["content.js", "apply-capture.js", "proposals-scan.js", "activity.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
